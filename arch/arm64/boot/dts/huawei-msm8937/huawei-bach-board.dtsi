/*
 * Huawei Bach board-level overrides carried from the 3.18 vendor tree.
 * Keep this file conservative: only add nodes that either match 4.9 drivers
 * or are harmless metadata needed by vendor userspace.
 */

/ {
	aliases {
		i2c1 = &i2c_1;
	};

	huawei_wifi_info {
		compatible = "huawei,hw_wifi_info";
		status = "ok";
		wifi,chiptype = "WIFI_QUALCOMM_WCN3680";
		wifi,pubfile_id = "bah_w09";
		wifi,fw_ver = "QCOM_WCN3680_2.0.2";
		wifi,ini_type = "bach";
	};

	huawei_bt_info {
		compatible = "huawei,hw_bt_info";
		status = "ok";
		bt,fw_ver = "QCOM_WCN3680_2.0.2";
		bt,chiptype = "BT_FM_QUALCOMM_WCN3680";
	};
};

&spmi_bus {
	qcom,pmi8950@2 {
		/delete-node/ qcom,leds@a100;
	};
};

&tlmm {
	gpio_led_pins {
		gpio_led_pinctrl: gpio_led_pinctrl {
			mux {
				pins = "gpio125", "gpio128";
				function = "gpio";
			};

			config {
				pins = "gpio125", "gpio128";
				drive-strength = <2>;
				bias-disable;
				output-low;
			};
		};
	};
};

&gpio_key_active {
	mux {
		pins = "gpio91";
		function = "gpio";
	};

	config {
		pins = "gpio91";
		drive-strength = <2>;
		bias-pull-up;
	};
};

&gpio_key_suspend {
	mux {
		pins = "gpio91";
		function = "gpio";
	};

	config {
		pins = "gpio91";
		drive-strength = <2>;
		bias-pull-up;
	};
};

&soc {
	/delete-node/ gpio_keys;

	gpio_keys {
		compatible = "gpio-keys";
		input-name = "gpio-keys";
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&gpio_key_active>;
		pinctrl-1 = <&gpio_key_suspend>;

		vol_up {
			label = "volume_up";
			gpios = <&tlmm 91 0x1>;
			linux,input-type = <1>;
			linux,code = <115>;
			debounce-interval = <15>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&gpio_led_pinctrl>;

		red {
			gpios = <&tlmm 128 0>;
			label = "red";
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
		};

		green {
			gpios = <&tlmm 125 0>;
			label = "green";
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
		};
	};
};

/* Add BAH-W09 battery profiles to existing mtp_batterydata node */
