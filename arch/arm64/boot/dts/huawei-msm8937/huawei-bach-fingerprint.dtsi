/*
 * Huawei BAH-W09 fingerprint — Goodix GF3208 (platform bus)
 *
 * SPI6 is enabled (pinctrl removed from base DTS to match 3.18).
 * The Goodix driver uses platform bus, so the fingerprint is a standalone
 * platform device, not an SPI child.
 *
 * GPIO 41 = power enable (goodix,gpio_ldo)
 * GPIO 46 = IRQ (goodix,gpio_irq)
 * GPIO 66 = reset (goodix,gpio_reset)
 */

&spi_6 {
	status = "okay";
};

/ {
	goodix_fp: goodix-fingerprint {
		compatible = "goodix,fingerprint";
		goodix,gpio_irq = <&tlmm 46 0>;
		goodix,gpio_reset = <&tlmm 66 0>;
		goodix,gpio_ldo = <&tlmm 41 0>;
		pinctrl-names = "default", "idle";
		pinctrl-0 = <&fingerprint_active>;
		pinctrl-1 = <&fingerprint_suspend>;
		status = "okay";
	};
};

&tlmm {
	fingerprint_active: fingerprint_active {
		mux {
			pins = "gpio66", "gpio46", "gpio41";
			function = "gpio";
		};
		config {
			pins = "gpio66", "gpio46", "gpio41";
			drive-strength = <2>;
			bias-pull-down;
		};
	};

	fingerprint_suspend: fingerprint_suspend {
		mux {
			pins = "gpio66", "gpio46", "gpio41";
			function = "gpio";
		};
		config {
			pins = "gpio66", "gpio46", "gpio41";
			drive-strength = <2>;
			bias-pull-down;
		};
	};
};
